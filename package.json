{
  "name": "gta8-cc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-search-index.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "search:index": "node scripts/generate-search-index.mjs",
    "cf:build": "node scripts/generate-search-index.mjs && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/generate-search-index.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply gta8-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gta8-db --remote"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "^16.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.0"
  }
}
