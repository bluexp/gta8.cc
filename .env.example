# Public site URL used for canonical links & coordinate share URLs
NEXT_PUBLIC_SITE_URL=https://gta8.cc

# Optional: Cloudflare R2 custom domain serving /{style}/{z}/{x}/{y}.webp map tiles
# Leave empty to use the built-in high-resolution procedural SVG Leonida basemaps
NEXT_PUBLIC_TILES_BASE_URL=

# Admin password protecting /admin and /api/admin/*
# Production: set via `npx wrangler secret put ADMIN_TOKEN`
ADMIN_TOKEN=change-me-to-a-strong-secret

# Optional: Cloudflare Turnstile secret key for /api/submissions anti-bot verification
# Production: set via `npx wrangler secret put TURNSTILE_SECRET_KEY`
TURNSTILE_SECRET_KEY=
